{
  "name": "gthf-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "infra:staging:build-frontend": "node infrastructure/scripts/build-staging-frontend.mjs",
    "infra:production:build-frontend": "node infrastructure/scripts/build-staging-frontend.mjs production",
    "infra:staging:dump-postgres": "node infrastructure/scripts/dump-clever-postgres.mjs",
    "infra:ovh:k9s": "node infrastructure/scripts/k9s-ovh-readonly.mjs",
    "postinstall": "next build",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test tests/*.test.ts",
    "test:components": "vitest run --config vitest.config.mts",
    "test:integration:prd01": "node scripts/check-prd01-local.mjs",
    "test:integration:prd02": "node scripts/check-prd02-local.mjs",
    "test:integration:prd02:geometry": "node --env-file=.env.local scripts/check-prd02-geometry-local.mjs",
    "test:delivery": "node --test tests/delivery-plan.test.ts tests/runtime-config.test.ts tests/release-health.test.ts tests/readiness.test.ts tests/staging-access.test.ts && python3 -m unittest discover -s infrastructure/delivery -p \"test_*.py\"",
    "test:delivery:runtime": "node tests/delivery-runtime.mjs",
    "infra:delivery:plan": "node infrastructure/delivery/plan.mjs",
    "infra:delivery": "python3 infrastructure/delivery/release.py",
    "infra:delivery:pull": "node infrastructure/delivery/reconcile.mjs",
    "infra:delivery:install": ".tmp/ansible/bin/ansible-playbook -i infrastructure/ansible/inventories/ovh/hosts.yml infrastructure/ansible/playbooks/install-delivery.yml",
    "infra:ansible:install": "python3 -m venv .tmp/ansible && .tmp/ansible/bin/pip install -r infrastructure/ansible/requirements.txt",
    "infra:staging:prepare": ".tmp/ansible/bin/ansible-playbook -i infrastructure/ansible/inventories/ovh/hosts.yml infrastructure/ansible/playbooks/prepare-staging.yml",
    "infra:credentials:upload": "node infrastructure/scripts/upload-gthf-credentials.mjs",
    "infra:staging:storage": ".tmp/ansible/bin/ansible-playbook -i infrastructure/ansible/inventories/ovh/hosts.yml infrastructure/ansible/playbooks/configure-staging-storage.yml",
    "infra:staging:data": ".tmp/ansible/bin/ansible-playbook -i infrastructure/ansible/inventories/ovh/hosts.yml infrastructure/ansible/playbooks/prepare-staging-data.yml",
    "infra:staging:media": ".tmp/ansible/bin/ansible-playbook -i infrastructure/ansible/inventories/ovh/hosts.yml infrastructure/ansible/playbooks/prepare-staging-media.yml",
    "test:e2e": "node infrastructure/delivery/recipe.mjs",
    "test:e2e:recovery": "node scripts/recovery/run.mjs",
    "infra:recovery:images": "node scripts/recovery/prepare-images.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "maplibre-gl": "^6.8.0",
    "marked": "^17.0.1",
    "next": "^16.3.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
